root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown hard line breaks are two trailing spaces (docs/MCP.md,
# docs/PWA.md, MANDELBROT-README.md), and trimming on save would delete them.
[*.{md,mdx}]
trim_trailing_whitespace = false
