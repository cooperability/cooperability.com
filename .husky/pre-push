# Blocks a push when a dependency has a CRITICAL advisory.
# Bypass in a genuine emergency with: git push --no-verify

set -e

echo ""
echo "Running security audit before push..."
echo ""

# `pnpm audit` replaces `yarn npm audit`. pnpm 11 no longer delegates audit to
# the npm CLI at all -- it queries npm's bulk advisories endpoint directly --
# so the old `yarn npm audit` phrasing has no pnpm equivalent and the flag is
# --audit-level, not --severity.
if pnpm audit --audit-level critical; then
    echo ""
    echo "No critical vulnerabilities found. Pushing."
    echo ""
else
    echo ""
    echo "--------------------------------------------------------------"
    echo "PUSH BLOCKED: critical vulnerabilities found."
    echo "--------------------------------------------------------------"
    echo ""
    echo "  See details:      pnpm audit"
    echo "  Bypass (unsafe):  git push --no-verify"
    echo ""
    exit 1
fi
