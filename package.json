{
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/build-sw.mjs && next-sitemap",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "type-check:dev": "tsc --noEmit --project tsconfig.dev.json",
    "test-types": "tsc --noEmit --project tsconfig.dev.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:mdx": "prettier --write '**/*.mdx'",
    "test": "jest --ci --watchAll=false",
    "prepare": "husky",
    "analyze": "cross-env ANALYZE=true next build",
    "access:run-audits": "cross-env NEXT_PUBLIC_AXE_FORCE_THEME='light' node scripts/create-report-dir.js && pnpm lint && axe http://localhost:3000 http://localhost:3000/demos http://localhost:3000/resources --tags wcag2aa --save ./accessibility-reports/axe-report.json --exit && lighthouse http://localhost:3000 --output json --output html --output-path ./accessibility-reports/lighthouse-report-home --only-categories=accessibility --chrome-flags='--headless --no-sandbox --disable-dev-shm-usage' && lighthouse http://localhost:3000/demos --output json --output html --output-path ./accessibility-reports/lighthouse-report-demos --only-categories=accessibility --chrome-flags='--headless --no-sandbox --disable-dev-shm-usage' && lighthouse http://localhost:3000/resources --output json --output html --output-path ./accessibility-reports/lighthouse-report-resources --only-categories=accessibility --chrome-flags='--headless --no-sandbox --disable-dev-shm-usage'",
    "access": "start-server-and-test dev http://localhost:3000 access:run-audits",
    "audit": "pnpm audit",
    "audit:critical": "pnpm audit --audit-level critical",
    "audit:fix": "pnpm audit --fix",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --watchAll=false --coverage",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.23",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.575.0",
    "next": "16.2.11",
    "next-mdx-remote": "6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark": "^14.0.3",
    "remark-html": "^16.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.3.2",
    "@next/eslint-plugin-next": "^16.3.2",
    "@serwist/build": "^9.5.12",
    "@swc/core": "^1.16.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "25.3.5",
    "@types/punycode": "^2.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.26",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.6",
    "punycode": "^2.3.1",
    "serwist": "^9.5.12",
    "start-server-and-test": "^2.1.5",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "webpack": "^5.109.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.mdx": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.24.0"
}
