{
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sw.mjs && next-sitemap",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "type-check:dev": "tsc --noEmit --project tsconfig.dev.json",
    "test-types": "tsc --noEmit --project tsconfig.dev.json",
    "lint": "eslint .",
    "lint:mdx": "eslint \"src/resources/**/*.mdx\"",
    "format": "prettier --write .",
    "format:mdx": "prettier --write '**/*.mdx'",
    "test": "jest --ci --watchAll=false",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --watchAll=false --coverage",
    "prepare": "husky",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "a11y:run-audits": "pnpm lint && node scripts/a11y-audit.mjs",
    "a11y": "cross-env NEXT_PUBLIC_AXE_FORCE_THEME=light start-server-and-test dev http://localhost:3000 a11y:run-audits",
    "audit": "pnpm audit",
    "audit:critical": "pnpm audit --audit-level critical",
    "audit:fix": "pnpm audit --fix",
    "ai:status": "node --env-file-if-exists=.env.local scripts/ai-switch.mjs status",
    "ai:off": "node --env-file-if-exists=.env.local scripts/ai-switch.mjs off",
    "ai:on": "node --env-file-if-exists=.env.local scripts/ai-switch.mjs on"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-mdx-remote": "6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10",
    "@next/bundle-analyzer": "^16.3.8",
    "@next/eslint-plugin-next": "^16.3.8",
    "@serwist/build": "^9.2.1",
    "@swc/core": "^1.16.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.4",
    "@types/punycode": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "acorn": "^8.15.0",
    "cross-env": "^7.0.3",
    "eslint": "10.11.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "punycode": "^2.3.1",
    "serwist": "^9.2.1",
    "start-server-and-test": "^3.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.0",
    "webpack": "^5.111.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.mdx": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.24.0"
}
