# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env
.DS_Store
.env*
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Competing lockfiles. Two lockfiles means two dependency trees and a coin
# flip over which one the deploy resolves. pnpm-lock.yaml is the only one.
package-lock.json
yarn.lock
bun.lockb

# Sitemap and robots.txt generated by next-sitemap in public/
public/sitemap.xml
public/sitemap-*.xml
public/robots.txt

# Service worker build output (generated from src/sw.js)
public/sw.js
public/workbox-*.js

# Cursor AI configuration
.cursorrules

# Misc
.env.local
.env.development.local
.env.test.local
.env.production.local

# pnpm
# node_modules is already ignored above. pnpm keeps every package ONCE in a
# global content-addressable store and hardlinks it into node_modules, so
# unlike the old Yarn PnP setup there is nothing package-related left to
# commit. The 1,379 .yarn/cache zips this repo used to track are gone, and so
# is the platform-specific exclusion list that existed only because a
# developer running install on Windows would otherwise overwrite the linux
# binaries Vercel needed. pnpm-lock.yaml is the only artifact git needs.
.pnpm-store/
.pnpm-debug.log*

# Generated build artifacts that were committed by accident
tsconfig.tsbuildinfo
/accessibility-reports/
